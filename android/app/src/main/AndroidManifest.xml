<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      ══════════════════════════════════════════════════════
      PERMISSIONS
      ══════════════════════════════════════════════════════
    -->

    <!-- Network access (required for Firebase, Weather API) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Location permissions — used by WeatherScreen.
      ACCESS_FINE_LOCATION: GPS-level accuracy.
      ACCESS_COARSE_LOCATION: Network-based location (fallback).
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      POST_NOTIFICATIONS — Required on Android 13+ (API 33+) to show notifications.
      Without this, no notifications appear on newer devices.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Vibrate for notification alerts -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      RECEIVE_BOOT_COMPLETED — Allows us to reschedule alarms after the device restarts.
      Without this, all alarms are lost when the phone reboots.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      SCHEDULE_EXACT_ALARM — Required on Android 12+ (API 31+) to schedule exact alarms.
      We use setAlarmClock() which is the recommended approach for alarm-clock apps.
      The user must grant this in Settings → Special app access → Alarms & reminders.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
      USE_FULL_SCREEN_INTENT — Required on Android 14+ (API 34+) to show full-screen
      alarm activities over the lock screen.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Wake lock — allows the alarm service to keep the CPU awake during playback -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      FOREGROUND_SERVICE — Required to start AlarmService as a foreground service.
      FOREGROUND_SERVICE_MEDIA_PLAYBACK — Declares the foreground service type.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!--
      READ_MEDIA_AUDIO / READ_EXTERNAL_STORAGE — for reading user-selected audio files.
      READ_MEDIA_AUDIO is the correct permission on Android 13+.
      READ_EXTERNAL_STORAGE is for API 32 and below.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
      USE_EXACT_ALARM — Required on Android 13+ (API 33+) as an alternative to
      SCHEDULE_EXACT_ALARM that doesn't require user approval for alarm-clock apps.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!--
      SYSTEM_ALERT_WINDOW — Allows showing AlarmActivity directly over any app or lock screen
      when an alarm or timer goes off.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- DISABLE_KEYGUARD — Allows waking device past keyguard on lockscreen -->
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />

    <!-- REQUEST_IGNORE_BATTERY_OPTIMIZATIONS — Ensures alarms & timers are not delayed by Doze -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">

      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!--
        AlarmActivity — full-screen native alarm & timer UI shown over the lock screen.
        showWhenLocked: displays above lock screen / keyguard (API 27+).
        turnScreenOn: turns screen on when launched (API 27+).
        showOnLockScreen / inheritShowWhenLocked: OEM compatibility (Xiaomi/MIUI, Samsung, Huawei).
        exported=false: only started by our own PendingIntents / direct intents.
      -->
      <activity
        android:name=".alarm.AlarmActivity"
        android:exported="false"
        android:excludeFromRecents="true"
        android:showWhenLocked="true"
        android:turnScreenOn="true"
        android:showOnLockScreen="true"
        android:inheritShowWhenLocked="true"
        android:taskAffinity="${applicationId}.alarm"
        android:launchMode="singleTask" />

      <!--
        AlarmService — foreground service for ringtone playback.
        foregroundServiceType="mediaPlayback" declares media audio playback on Android 10+.
      -->
      <service
        android:name=".alarm.AlarmService"
        android:exported="false"
        android:foregroundServiceType="mediaPlayback" />

      <!--
        AlarmReceiver — BroadcastReceiver for AlarmManager exact alarms.
        exported=true IS required on Android 12+ for AlarmManager to be able to
        deliver broadcasts to the receiver via PendingIntent.getBroadcast().
        The explicit package in the PendingIntent limits who can trigger this.
      -->
      <receiver
        android:name=".alarm.AlarmReceiver"
        android:exported="true">
        <intent-filter>
          <action android:name="com.duodevs.lifehub.ALARM_FIRE" />
          <action android:name="com.duodevs.lifehub.STOP_ALARM" />
          <action android:name="com.duodevs.lifehub.SNOOZE_ALARM" />
        </intent-filter>
      </receiver>

      <!--
        TimerReceiver — BroadcastReceiver for timer completion and stop actions.
        exported=true IS required on Android 12+ for AlarmManager to be able to
        deliver broadcasts to the receiver via PendingIntent.getBroadcast().
      -->
      <receiver
        android:name=".alarm.TimerReceiver"
        android:exported="true">
        <intent-filter>
          <action android:name="com.duodevs.lifehub.TIMER_FIRE" />
          <action android:name="com.duodevs.lifehub.STOP_TIMER" />
        </intent-filter>
      </receiver>

      <!--
        BootReceiver — reschedules alarms after device reboot.
        exported=true IS required for BOOT_COMPLETED receivers on Android 12+.
        Do NOT use android:permission here — the system sends BOOT_COMPLETED and
        we must not restrict who can broadcast to us with a permission guard on
        the receiver element. The RECEIVE_BOOT_COMPLETED uses-permission above
        declares our intent to receive the broadcast.
      -->
      <receiver
        android:name=".alarm.BootReceiver"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.BOOT_COMPLETED" />
          <action android:name="android.intent.action.QUICKBOOT_POWERON" />
          <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
        </intent-filter>
      </receiver>

      <!--
        Firebase Cloud Messaging Service.
        Handles FCM push notifications in both foreground and background.
        @react-native-firebase/messaging registers this automatically via autolinking.
      -->
      <service
        android:name="io.invertase.firebase.messaging.ReactNativeFirebaseMessagingService"
        android:exported="false">
        <intent-filter>
          <action android:name="com.google.firebase.MESSAGING_EVENT" />
        </intent-filter>
      </service>

      <!--
        Notifee Boot Receiver.
        Reschedules Notifee trigger notifications (habit reminders, etc.) after reboot.
        This does NOT handle alarm scheduling (our AlarmReceiver does that).
      -->
      <receiver
        android:name="app.notifee.core.BootReceiver"
        android:exported="false">
        <intent-filter>
          <action android:name="android.intent.action.BOOT_COMPLETED" />
          <action android:name="android.intent.action.QUICKBOOT_POWERON" />
        </intent-filter>
      </receiver>

    </application>
</manifest>
